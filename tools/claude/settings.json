{
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" running 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "d=$(readlink \"$HOME/.tmux.conf\") && \"${d%/*}/scripts/tmux-agent-title.sh\" sync claude 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" running 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" done 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "d=$(readlink \"$HOME/.tmux.conf\") && \"${d%/*}/scripts/tmux-agent-title.sh\" sync claude 2>/dev/null || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" done 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/dracula-tmux/scripts/agent_state.sh\" clear 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "d=$(readlink \"$HOME/.tmux.conf\") && \"${d%/*}/scripts/tmux-agent-title.sh\" clear 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node $HOME/.claude/hud/status.mjs"
  },
  "enabledPlugins": {
    "claude-code-wakatime@wakatime": true
  },
  "extraKnownMarketplaces": {
    "kicad-happy": {
      "source": {
        "source": "github",
        "repo": "aklofas/kicad-happy"
      }
    },
    "jlcpcb-skills": {
      "source": {
        "source": "github",
        "repo": "mash/jlcpcb-skills"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "promptSuggestionEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false,
  "skipAutoPermissionPrompt": true
}
